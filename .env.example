# ------------------------------------------------------------------
# ThinkStack environment configuration
# Copy this file to ".env" and adjust values for your machine.
# NEVER commit your real ".env" file or real secrets.
# ------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_DB=thinkstack
POSTGRES_USER=thinkstack
POSTGRES_PASSWORD=thinkstack_dev_2024
POSTGRES_PORT=5432

# --- Spring Boot database connection ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thinkstack
DB_USERNAME=thinkstack
DB_PASSWORD=thinkstack_dev_2024

# --- JWT (replace with a long random string in production) ---
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# --- Server ---
SERVER_PORT=8080

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001